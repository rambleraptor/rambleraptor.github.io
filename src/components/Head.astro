---
import { SEO } from "astro-seo";
import Plausible from "./Plausible.astro";

interface Props {
  title: string;
  description: string;
  type?: "website" | "article";
  // Structured data (schema.org) rendered as JSON-LD.
  jsonLd?: object;
}

const { title, description, type = "website", jsonLd } = Astro.props;
const image = new URL("/og-image.png", Astro.site).href;
---

<head>
  <meta charset="utf-8" />
  <meta http-equiv="x-ua-compatible" content="ie=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <Plausible domain="alexstephen.me" />

  <SEO
    title={title}
    description={description}
    openGraph={{
      basic: {
        title: title,
        type: type,
        image: image,
      },
      optional: {
        description: description,
        siteName: "Alex Stephen",
      },
      image: {
        width: 1200,
        height: 630,
        alt: "Alex Stephen, Software Engineer",
      },
    }}
    twitter={{
      card: "summary_large_image",
      creator: "@rambleraptor",
      title: title,
      description: description,
      image: image,
    }}
    extend={{
      // extending the default link tags
      link: [
        { rel: "icon", href: "/favicon.ico" },
        { rel: "sitemap", href: "/sitemap-index.xml" },
        {
          rel: "alternate",
          type: "application/rss+xml",
          title: "Alex Stephen",
          href: "/feed.xml",
        },
      ],
    }}
  />

  {
    jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )
  }
</head>
