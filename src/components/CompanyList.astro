---
interface Company {
  name: string;
  role: string;
  years: string;
  url?: string;
}

const companies: Company[] = [
  {
    name: "Google",
    role: "BigQuery",
    years: "2021 — Present",
    url: "https://www.google.com"
  },
  {
    name: "Google",
    role: "Declarative Tools & Code Generators",
    years: "2019 — 2021",
    url: "https://www.google.com"
  },
  {
    name: "Palantir",
    role: "Data Pipelines",
    years: "2017 — 2019",
    url: "https://www.palantir.com"
  },
  {
    name: "Rippling",
    role: "Insurance Software",
    years: "2016 — 2017",
    url: "https://www.rippling.com"
  },
  {
    name: "University of Michigan",
    role: "Go Blue!",
    years: "2012 — 2016",
    url: "https://www.umich.edu"
  }
];
---

<div class="work-list">
  {companies.map((company) => (
    <div class="work-item">
      <div class="work-company">
        {company.url ? (
          <a href={company.url} target="_blank" rel="noopener noreferrer">
            {company.name}
          </a>
        ) : (
          <span>{company.name}</span>
        )}
      </div>
      <div class="work-details">
        <div class="work-role">{company.role}</div>
        <div class="work-years">{company.years}</div>
      </div>
    </div>
  ))}
</div>

<style>
  .work-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin: 2rem 0;
  }

  .work-item {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 2rem;
    align-items: start;
  }

  .work-company {
    font-weight: 600;
    font-size: 1rem;
    color: #111827;
  }

  .work-company a {
    color: #111827;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .work-company a:hover {
    color: #3b82f6;
  }

  .work-details {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .work-role {
    font-size: 1rem;
    color: #374151;
    line-height: 1.5;
  }

  .work-years {
    font-size: 0.875rem;
    color: #6b7280;
    font-family: ui-monospace, 'Cascadia Code', 'Source Code Pro', Menlo, Consolas, 'DejaVu Sans Mono', monospace;
  }

  @media (max-width: 640px) {
    .work-item {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }

    .work-company {
      font-size: 0.9375rem;
    }

    .work-role {
      font-size: 0.9375rem;
    }

    .work-years {
      font-size: 0.8125rem;
    }
  }
</style>
