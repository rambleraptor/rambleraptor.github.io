---
import Twitter from "./icons/Twitter.astro";
import Letterboxd from "./icons/Letterboxd.astro";
import LinkedIn from "./icons/LinkedIn.astro";
import GitHub from "./icons/GitHub.astro";
import RSS from "./icons/RSS.astro";

const iconClass =
  "h-8 w-8 fill-current text-gray-900 hover:text-white dark:text-gray-100 dark:hover:text-white";
---

<div
  class="flex h-20 w-full flex-row items-center justify-center gap-8 bg-blue-300 dark:bg-blue-900"
>
  <a href="https://www.twitter.com/rambleraptor">
    <Twitter className={iconClass} />
  </a>
  <a href="https://www.github.com/rambleraptor">
    <GitHub className={iconClass} />
  </a>
  <a href="https://www.letterboxd.com/rambleraptor">
    <Letterboxd className={iconClass} />
  </a>
  <a href="https://www.linkedin.com/in/rambleraptor">
    <LinkedIn className={iconClass} />
  </a>
  <a href="/feed.xml">
    <RSS className={iconClass} />
  </a>
</div>
