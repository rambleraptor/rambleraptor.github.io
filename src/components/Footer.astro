---
import Twitter from "./icons/Twitter.astro";
import Letterboxd from "./icons/Letterboxd.astro";
import LinkedIn from "./icons/LinkedIn.astro";
import GitHub from "./icons/GitHub.astro";
import RSS from "./icons/RSS.astro";

const linkClass =
  "text-gray-900 no-underline hover:text-white dark:text-gray-100 dark:hover:text-white";
const iconClass =
  "h-8 w-8 fill-current text-gray-900 hover:text-white dark:text-gray-100 dark:hover:text-white";
---

<footer
  class="flex w-full flex-col items-center gap-4 bg-blue-300 py-6 dark:bg-blue-900"
>
  <div class="flex flex-row items-center justify-center gap-8">
    <a href="https://www.twitter.com/rambleraptor" aria-label="Twitter">
      <Twitter className={iconClass} />
    </a>
    <a href="https://www.github.com/rambleraptor" aria-label="GitHub">
      <GitHub className={iconClass} />
    </a>
    <a href="https://www.letterboxd.com/rambleraptor" aria-label="Letterboxd">
      <Letterboxd className={iconClass} />
    </a>
    <a href="https://www.linkedin.com/in/rambleraptor" aria-label="LinkedIn">
      <LinkedIn className={iconClass} />
    </a>
    <a href="/feed.xml" aria-label="RSS feed">
      <RSS className={iconClass} />
    </a>
  </div>
  <nav
    class="flex flex-row flex-wrap items-center justify-center gap-6 text-sm"
  >
    <a class={linkClass} href="/">Home</a>
    <a class={linkClass} href="/writing">Writing</a>
    <a class={linkClass} href="/talks">Talks</a>
    <a class={linkClass} href="mailto:astephen2@gmail.com"
      >astephen2@gmail.com</a
    >
  </nav>
</footer>
