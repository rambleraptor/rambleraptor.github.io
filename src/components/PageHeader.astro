---
// The one place page and post titles are styled. The optional slot holds a
// meta line (description, date, tags) rendered in muted text.
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<header class="mb-8 md:mb-10">
  <h1
    class="text-3xl font-extrabold leading-tight tracking-tight text-gray-950 md:text-4xl dark:text-white"
  >
    {title}
  </h1>
  {
    Astro.slots.has("default") && (
      <div class="mt-3 text-base text-gray-600 dark:text-gray-400">
        <slot />
      </div>
    )
  }
</header>
