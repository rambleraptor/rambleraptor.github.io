---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Slide {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}

interface Props {
  slides: Slide[];
  label?: string;
}

const { slides, label = "Image carousel" } = Astro.props;
---

<div
  class="not-prose my-8"
  role="region"
  aria-roledescription="carousel"
  aria-label={label}
  data-carousel
>
  <div
    class="carousel-track flex snap-x snap-mandatory overflow-x-auto scroll-smooth"
    data-carousel-track
  >
    {
      slides.map((slide, i) => (
        <figure
          class="flex w-full shrink-0 snap-center flex-col items-center"
          role="group"
          aria-roledescription="slide"
          aria-label={`${i + 1} of ${slides.length}`}
          data-carousel-slide
        >
          <Image src={slide.src} alt={slide.alt} width={400} class="max-w-xs" />
          {slide.caption && (
            <figcaption class="mt-3 max-w-md text-center text-sm text-gray-600">
              {slide.caption}
            </figcaption>
          )}
        </figure>
      ))
    }
  </div>

  <div class="mt-4 flex items-center justify-center gap-4">
    <button
      type="button"
      class="rounded-full px-2 text-2xl leading-none text-gray-500 hover:text-gray-900 disabled:opacity-30"
      aria-label="Previous image"
      data-carousel-prev
    >
      &larr;
    </button>
    <div class="flex gap-2">
      {
        slides.map((_, i) => (
          <button
            type="button"
            class="h-2.5 w-2.5 rounded-full bg-gray-300 aria-[current=true]:bg-blue-500"
            aria-label={`Go to image ${i + 1}`}
            aria-current={i === 0 ? "true" : "false"}
            data-carousel-dot
          />
        ))
      }
    </div>
    <button
      type="button"
      class="rounded-full px-2 text-2xl leading-none text-gray-500 hover:text-gray-900 disabled:opacity-30"
      aria-label="Next image"
      data-carousel-next
    >
      &rarr;
    </button>
  </div>
</div>

<style>
  .carousel-track {
    scrollbar-width: none;
  }
  .carousel-track::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((root) => {
    const track = root.querySelector<HTMLElement>("[data-carousel-track]")!;
    const slides = [...root.querySelectorAll<HTMLElement>("[data-carousel-slide]")];
    const dots = [...root.querySelectorAll<HTMLButtonElement>("[data-carousel-dot]")];
    const prev = root.querySelector<HTMLButtonElement>("[data-carousel-prev]")!;
    const next = root.querySelector<HTMLButtonElement>("[data-carousel-next]")!;

    const current = () => Math.round(track.scrollLeft / track.clientWidth);
    const goTo = (i: number) =>
      track.scrollTo({ left: slides[i].offsetLeft - track.offsetLeft });

    const update = () => {
      const i = current();
      dots.forEach((dot, j) => dot.setAttribute("aria-current", String(i === j)));
      prev.disabled = i === 0;
      next.disabled = i === slides.length - 1;
    };

    prev.addEventListener("click", () => goTo(Math.max(current() - 1, 0)));
    next.addEventListener("click", () =>
      goTo(Math.min(current() + 1, slides.length - 1)),
    );
    dots.forEach((dot, i) => dot.addEventListener("click", () => goTo(i)));
    track.addEventListener("scroll", update, { passive: true });
    update();
  });
</script>
