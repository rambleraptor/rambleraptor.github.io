---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  width?: number;
}

const { src, alt, width = 400 } = Astro.props;
---

<figure class="not-prose my-8 flex flex-col items-center">
  <Image src={src} alt={alt} width={width} class="max-w-xs" />
  {
    Astro.slots.has("default") && (
      <figcaption class="mt-3 max-w-md text-center text-sm text-gray-600">
        <slot />
      </figcaption>
    )
  }
</figure>
