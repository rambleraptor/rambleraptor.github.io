---
interface Props {
  // Path under public/ without an extension. Expects `${src}.webm`,
  // `${src}.mp4`, and `${src}-poster.jpg` to exist.
  src: string;
  label: string;
}

const { src, label } = Astro.props;
---

<figure class="not-prose my-8 flex flex-col items-center">
  <video
    class="max-w-xs"
    autoplay
    loop
    muted
    playsinline
    poster={`${src}-poster.jpg`}
    aria-label={label}
  >
    <source src={`${src}.webm`} type="video/webm" />
    <source src={`${src}.mp4`} type="video/mp4" />
  </video>
  {
    Astro.slots.has("default") && (
      <figcaption class="mt-3 max-w-md text-center text-sm text-gray-600">
        <slot />
      </figcaption>
    )
  }
</figure>
