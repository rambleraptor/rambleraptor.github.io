---
import WritingList from "../components/writing/WritingList.astro";
import PageHeader from "../components/PageHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getAllPosts } from "../utils/posts";

const allPosts = await getAllPosts();
---

<BaseLayout
  title="Writing | Alex Stephen"
  description="Essays and blog posts by Alex Stephen on APIs, developer tools, AI, technology, and pop culture, told through data and storytelling."
>
  <PageHeader title="Writing">
    <p>
      I'm an aspiring writer. I love talking about pop culture, technology, and
      business through the lens of data and storytelling.
    </p>
  </PageHeader>
  <WritingList posts={allPosts} />
</BaseLayout>
