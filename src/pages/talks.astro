---
import { getCollection } from "astro:content";
import TalksList from "../components/TalksList.astro";
import PageHeader from "../components/PageHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const allTalkFiles = await getCollection("talks");
const talks = allTalkFiles[0];
---

<BaseLayout
  title="Talks | Alex Stephen"
  description="Conference talks by Alex Stephen on Apache Iceberg, Ansible, Kubernetes, code generation, and cloud developer tooling, with links to videos."
>
  <PageHeader title="Talks" />
  <TalksList talks={talks} />
</BaseLayout>
