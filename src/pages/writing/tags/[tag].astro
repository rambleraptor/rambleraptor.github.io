---
import WritingList from "../../../components/writing/WritingList.astro";
import PageHeader from "../../../components/PageHeader.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getAllTags, getPostsByTag } from "../../../utils/posts";

export async function getStaticPaths() {
  const uniqueTags = await getAllTags();

  return uniqueTags.map((tag) => ({
    params: { tag },
    props: { tag },
  }));
}

const { tag } = Astro.params;
const posts = await getPostsByTag(tag);
---

<BaseLayout
  title={`Writing about ${tag} | Alex Stephen`}
  description={`Essays and blog posts by Alex Stephen tagged "${tag}". Browse writing on technology, APIs, developer tools, and pop culture.`}
>
  <PageHeader title={`Writing / ${tag}`}>
    <p>
      <a
        class="text-blue-700 hover:underline dark:text-blue-400"
        href="/writing">All writing</a
      >
    </p>
  </PageHeader>
  <WritingList posts={posts} />
</BaseLayout>
