---
import Head from "../components/Head.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  frontmatter?: FrontMatter;
}

interface FrontMatter {
  title: string;
  description: string;
}

const { title, description, frontmatter } = Astro.props;

var realTitle: string = "";
var realDescription: string = "";
if (frontmatter != null) {
  realTitle = frontmatter!.title;
  realDescription = frontmatter!.description;
} else {
  realTitle = title!;
  realDescription = description!;
}
---

<!doctype html>
<html lang="en">
  <Head title={realTitle} description={realDescription} />
  <body class="bg-white">
    <div class="border-t-4 border-solid border-blue-500"></div>
    <Navbar />
    <div class="container mx-auto max-w-3xl px-6 py-12 md:px-8 md:py-16">
      <div class="prose prose-lg prose-slate max-w-none">
        <slot />
      </div>
    </div>
    <Footer />
    <style>
      .prose h1 {
        font-size: 2.5rem;
        font-weight: 700;
        line-height: 1.2;
        margin-bottom: 1rem;
        color: #0f172a;
      }

      .prose h2 {
        font-size: 1.5rem;
        font-weight: 600;
        margin-top: 2.5rem;
        margin-bottom: 1rem;
        color: #1e293b;
      }

      .prose p {
        font-size: 1.125rem;
        line-height: 1.75;
        margin-bottom: 1.5rem;
        color: #475569;
      }

      .prose a {
        color: #3b82f6;
        text-decoration: none;
        font-weight: 500;
      }

      .prose a:hover {
        color: #2563eb;
        text-decoration: underline;
      }

      .list {
        padding-left: 0px;
      }
    </style>
  </body>
</html>
