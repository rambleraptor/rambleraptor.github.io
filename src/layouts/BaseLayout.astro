---
import Head from "../components/Head.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  frontmatter?: FrontMatter;
}

interface FrontMatter {
  title: string;
  description: string;
}

const { title, description, frontmatter } = Astro.props;

var realTitle: string = "";
var realDescription: string = "";
if (frontmatter != null) {
  realTitle = frontmatter!.title;
  realDescription = frontmatter!.description;
} else {
  realTitle = title!;
  realDescription = description!;
}
---

<!doctype html>
<html lang="en">
  <Head title={realTitle} description={realDescription} />
  <body>
    <div class="border-8 border-solid border-blue-500"></div>
    <Navbar />
    <div class="container prose prose-lg mx-auto pb-10 pl-3 pr-3">
      <div><slot /></div>
    </div>
    <Footer />
    <style>
      /* Tailwind is really hard to use, so I have to do this. */
      .hero-image {
        margin-top: 0 !important;
      }

      .list {
        padding-left: 0px;
      }

      /* Homepage minimalist styles */
      .homepage-header {
        margin-bottom: 4rem;
      }

      .homepage-title {
        font-size: 2.25rem;
        font-weight: 700;
        color: #0f172a;
        margin: 0 0 1rem 0 !important;
        letter-spacing: -0.025em;
      }

      .homepage-bio {
        font-size: 1.125rem;
        color: #64748b;
        margin: 0 !important;
        line-height: 1.7;
        max-width: 600px;
      }

      .content-sections {
        display: flex;
        flex-direction: column;
        gap: 4rem;
      }

      .content-section {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
      }

      .section-title {
        font-size: 0.875rem;
        font-weight: 600;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin: 0 !important;
      }

      .link-list {
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }

      .link-item {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        padding: 0.75rem 0;
        text-decoration: none;
        transition: all 0.15s ease;
        border-radius: 0.375rem;
      }

      .link-item:hover {
        background-color: #f8fafc;
        padding-left: 0.5rem;
        padding-right: 0.5rem;
      }

      .link-label {
        font-weight: 600;
        font-size: 1rem;
        color: #0f172a;
      }

      .link-description {
        font-size: 0.875rem;
        color: #64748b;
      }

      @media (max-width: 640px) {
        .homepage-title {
          font-size: 1.875rem;
        }

        .homepage-bio {
          font-size: 1rem;
        }

        .content-sections {
          gap: 3rem;
        }
      }
    </style>
  </body>
</html>
