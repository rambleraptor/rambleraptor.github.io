---
import Head from "../components/Head.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

// The page shell: head, navbar, a centered column, and footer.
// It applies no typography of its own. Article bodies opt into prose
// through PostLayout or PageLayout; index and list pages style themselves.
interface Props {
  title: string;
  description: string;
  type?: "website" | "article";
  jsonLd?: object;
}

const { title, description, type, jsonLd } = Astro.props;
---

<!doctype html>
<html lang="en">
  <Head title={title} description={description} type={type} jsonLd={jsonLd} />
  <body
    class="min-h-screen bg-white text-gray-900 antialiased dark:bg-gray-950 dark:text-gray-100"
  >
    <div class="border-t-8 border-solid border-blue-500"></div>
    <Navbar />
    <main class="mx-auto w-full max-w-3xl px-4 pb-16 pt-6 sm:px-6 md:pt-10">
      <slot />
    </main>
    <Footer />
  </body>
</html>
